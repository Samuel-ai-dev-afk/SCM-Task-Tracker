// Prisma schema for the SCM Task Tracker.
//
// PRODUCTION: PostgreSQL (Neon / Supabase). DATABASE_URL is set in .env locally
// and in the Vercel dashboard in production.
// (To run locally on zero-setup SQLite instead, change provider to "sqlite" and
// set DATABASE_URL="file:./dev.db" — role is a String and dates are plain
// DateTime, so the schema is valid on both databases.)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  // App runtime uses the pooled connection; schema changes (db push) use the
  // direct connection. Supabase's Connect dialog gives you both strings.
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  // "manager" | "staff" — validated in the app layer.
  role         String
  passwordHash String
  active       Boolean  @default(true)
  // Self-signups start unapproved (active = false, approved = false) and sit in
  // the manager approval queue. People a manager adds directly are approved on
  // creation, and every existing row defaults to true.
  approved     Boolean  @default(true)
  createdAt    DateTime @default(now())

  // Relations
  tasksAssigned Task[]    @relation("assignedFrom")
  tasksReceived Task[]    @relation("assignedTo")
  comments      Comment[]
  calendarEntries CalendarEntry[]

  @@index([active])
}

model Task {
  id              String    @id @default(cuid())
  title           String
  description     String    @default("")
  // Which strategic pillar this task supports. Null = none.
  strategicPillar String?
  // Status is validated in the app layer against the canonical list.
  status          String    @default("Not Started")
  fileLink        String?
  // Time the assignee logged against this task, in whole minutes. Null = not
  // recorded yet. Stored as minutes so hour/minute maths stays exact.
  minutesSpent    Int?
  // When this goes live. Distinct from `deadline`: the deadline is when the
  // work is due internally, the publish date is when the audience sees it, and
  // the gap between them is the buffer.
  publishDate     DateTime?
  // Where it goes live. Free-form on purpose — validated against CHANNELS in
  // the app layer, same approach as status and pillar.
  channel         String?
  dateAssigned    DateTime
  deadline        DateTime?
  dateCompleted   DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  assignedFromId String
  assignedFrom   User   @relation("assignedFrom", fields: [assignedFromId], references: [id])

  assignedToId String
  assignedTo   User   @relation("assignedTo", fields: [assignedToId], references: [id])

  comments Comment[]

  @@index([assignedToId])
  @@index([status])
  @@index([dateAssigned])
  @@index([deadline])
  @@index([dateCompleted])
  @@index([publishDate])
}

/*
  Something on the calendar that isn't assigned work: a meeting, an event, a
  planned post, a reminder. Deliberately NOT a Task — it has no assignee,
  deadline or status, and it must never appear on the task board or count
  toward anyone's logged hours.
*/
model CalendarEntry {
  id        String   @id @default(cuid())
  title     String
  // "Meeting" | "Event" | "Post" | "Reminder" — validated in the app layer.
  kind      String
  date      DateTime
  // Clock time as "HH:MM", or null for an all-day entry. Stored as text so it
  // can't drift with timezones the way a DateTime would.
  time      String?
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  createdById String
  createdBy   User   @relation(fields: [createdById], references: [id])

  @@index([date])
}

model Comment {
  id        String   @id @default(cuid())
  body      String
  createdAt DateTime @default(now())

  taskId String
  task   Task   @relation(fields: [taskId], references: [id], onDelete: Cascade)

  authorId String
  author   User   @relation(fields: [authorId], references: [id])

  @@index([taskId])
}
