# Copy to .env and fill in. (A ready-to-go local .env is already included.)

# ---- Database ----
# LOCAL (SQLite, zero setup) — this is the default in schema.prisma:
DATABASE_URL="file:./dev.db"
#
# PRODUCTION (PostgreSQL on Neon/Supabase) — also change the datasource
# provider in prisma/schema.prisma from "sqlite" to "postgresql":
# DATABASE_URL="postgresql://user:password@host:5432/scm_tracker?sslmode=require"

# ---- NextAuth ----
NEXTAUTH_URL="http://localhost:3000"
# Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# ---- Seed ----
# Shared starter password given to every seeded user.
SEED_PASSWORD="changeme123"
